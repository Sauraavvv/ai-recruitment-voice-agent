# Run from the repository root. Paths are quoted because the folder name contains a space.
SHELL := /bin/bash
BACKEND := backend
VENV := $(BACKEND)/.venv/bin

.PHONY: help env up down logs ps test test-docker lint fmt typecheck lock venv check-secrets shell-db \
	migrate migration create-user types agent-cli agent-eval llm-bench \
	tts-model tts-say test-tts test-deepgram-tts bench-tts \
	stt-clips stt-file stt-mic stt-record voice-loop test-stt bench-stt \
	tunnel exotel-urls test-call voice-sim \
	final-pass-check \
	dashboard-check test-frontend test-e2e

help:
	@grep -E '^[a-z-]+:' Makefile | cut -d: -f1 | tr '\n' ' '; echo

env:  ## Create .env with a random APP_SECRET_KEY (won't overwrite an existing .env)
	@if [ -f .env ]; then echo ".env already exists"; else \
	  sed "s|^APP_SECRET_KEY=.*|APP_SECRET_KEY=$$(python3 -c 'import secrets; print(secrets.token_urlsafe(48))')|" .env.example > .env; \
	  echo "Created .env"; fi

up:
	docker compose up -d --build

down:
	docker compose down

logs:
	docker compose logs -f --tail=100

ps:
	docker compose ps

venv:
	cd "$(BACKEND)" && uv venv -p python3.12 .venv -q && uv pip install -q -p .venv -r requirements.txt -r requirements-dev.txt && uv pip install -q -p .venv --no-deps -r requirements-nodeps.txt

lock:
	cd "$(BACKEND)" && uv pip compile requirements.in --python-version 3.12 --generate-hashes -o requirements.txt -q \
	  && uv pip compile requirements-dev.in --python-version 3.12 -o requirements-dev.txt -q

test:
	cd "$(BACKEND)" && .venv/bin/pytest -q

test-docker:  ## Runs tests inside the backend container against the real Postgres and Redis
	docker compose exec -T \
	  -e TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/recruitment_ai_test \
	  -e TEST_REDIS_URL=redis://redis:6379/0 \
	  backend pytest -q -p no:cacheprovider

lint:
	cd "$(BACKEND)" && .venv/bin/ruff check . && .venv/bin/ruff format --check .
	cd frontend && npm run lint

fmt:
	cd "$(BACKEND)" && .venv/bin/ruff check --fix . && .venv/bin/ruff format .
	cd frontend && npm run format

typecheck:
	cd "$(BACKEND)" && .venv/bin/mypy
	cd frontend && npm run typecheck

check-secrets:
	@if command -v gitleaks >/dev/null; then gitleaks detect --no-banner -v; \
	else echo "gitleaks not installed (brew install gitleaks)"; exit 1; fi

shell-db:
	docker compose exec postgres psql -U postgres -d recruitment_ai

migrate:  ## Apply database migrations
	docker compose exec -T backend alembic upgrade head

migration:  ## New autogenerated migration: make migration m="add x"
	@test -n "$(m)" || (echo 'usage: make migration m="description"'; exit 1)
	docker compose exec -T backend alembic revision --autogenerate -m "$(m)"

create-user:  ## Create or reset a login: make create-user email=a@b.com name="A B" [role=super_admin] [org="Acme"]
	@test -n "$(email)" -a -n "$(name)" || (echo 'usage: make create-user email=you@example.com name="Your Name"'; exit 1)
	docker compose exec backend python -m app.scripts.create_user --email "$(email)" --name "$(name)" $(if $(role),--role "$(role)") $(if $(org),--organization "$(org)")

types:  ## Regenerate frontend/types/api.ts from the backend's OpenAPI schema
	docker compose exec -T backend python -m app.scripts.export_openapi > frontend/types/openapi.json
	cd frontend && npm run gen:types

# --- Phase 2: screening agent (these call the real OpenAI API and cost money) ---

agent-cli:  ## Chat with the agent: make agent-cli [args='--replay app/tests/agent_eval/scenarios/s14_happy_path.yaml']
	docker compose exec backend python -m app.agent.cli $(args)

agent-eval:  ## Live scenario evaluation: make agent-eval [args='-s s07 --runs 1']
	docker compose exec -T backend python -m app.tests.agent_eval.runner $(args)

llm-bench:  ## Latency benchmark: make llm-bench models=model-a,model-b [args='--effort none']
	@test -n "$(models)" || (echo 'usage: make llm-bench models=model-a,model-b'; exit 1)
	docker compose exec -T backend python -m app.tests.agent_eval.bench --models "$(models)" $(args)

# --- Phase 3: Kitten TTS (the model is baked into the Docker image) ---

tts-model:  ## Download the TTS model for the local venv (Docker images already have it)
	cd "$(BACKEND)" && .venv/bin/python app/scripts/download_tts_model.py --dest models/kitten-tts-2-nano

tts-say:  ## Speak a line and play it: make tts-say TEXT="Hello Priya" [PHONE=1] [VOICE=..] [PROVIDER=kitten]
	@test -n "$(TEXT)" || (echo 'usage: make tts-say TEXT="Hello, am I speaking with Priya Iyer?" [PHONE=1]'; exit 1)
	docker compose exec -T backend python -m app.scripts.tts_say --no-play "$(TEXT)" \
	  $(if $(PHONE),--phone) $(if $(VOICE),--voice "$(VOICE)") $(if $(PROVIDER),--provider "$(PROVIDER)")
	@if command -v afplay >/dev/null; then afplay "$(BACKEND)/artifacts/tts/last.wav"; \
	  if [ -n "$(PHONE)" ]; then afplay "$(BACKEND)/artifacts/tts/last-8k.wav"; fi; fi

test-tts:  ## Real-model TTS tests (about 2 minutes)
	docker compose exec -T backend pytest -q -p no:cacheprovider -m tts app/tests/integration/test_kitten_provider.py

test-deepgram-tts:  ## Live Deepgram TTS tests (a few cents)
	docker compose exec -T backend pytest -q -p no:cacheprovider -m deepgram app/tests/integration/test_deepgram_tts.py

bench-tts:  ## TTS latency benchmark: make bench-tts [args='--runs 50 --threads 1,2,4']
	docker compose exec -T backend python -m app.scripts.bench_tts $(args)

# --- Phase 4: Deepgram STT. Microphone, `say` and recording tools run on the Mac host. ---
# Host tools read the root .env themselves (the backend's settings look for .env in backend/).
HOST_RUN := set -a && . ./.env && set +a && cd "$(BACKEND)" && .venv/bin/python -m

stt-clips:  ## Generate the synthetic STT test clips with macOS `say` (host)
	cd "$(BACKEND)" && .venv/bin/python -m app.scripts.make_stt_clips

stt-file:  ## Stream a WAV like a call: make stt-file FILE=artifacts/stt-audio/synthetic/rishi/c07_multi_answer.wav [RATE=8000]
	@test -n "$(FILE)" || (echo 'usage: make stt-file FILE=artifacts/stt-audio/synthetic/rishi/c07_multi_answer.wav [RATE=8000]'; exit 1)
	docker compose exec -T backend python -m app.scripts.stt_file "$(FILE)" $(if $(RATE),--rate $(RATE)) $(args)

stt-mic:  ## Live microphone transcription (host): make stt-mic [RATE=8000]
	$(HOST_RUN) app.scripts.stt_mic $(if $(RATE),--rate $(RATE)) $(args)

stt-record:  ## Record real test clips (host, with consent): make stt-record SPEAKER=name [ONLY=c09]
	@test -n "$(SPEAKER)" || (echo 'usage: make stt-record SPEAKER=name [ONLY=c01,c09]'; exit 1)
	cd "$(BACKEND)" && .venv/bin/python -m app.scripts.stt_record --speaker "$(SPEAKER)" $(if $(ONLY),--only "$(ONLY)")

voice-loop:  ## Talk to the agent through STT (host): make voice-loop [SPEAK=1] [SCRIPT=s14_happy_path] [RATE=8000]
	$(HOST_RUN) app.voice.local_loop $(if $(SPEAK),--speak) $(if $(SCRIPT),--script "$(SCRIPT)") $(if $(RATE),--rate $(RATE)) $(args)

# --- Phase 6: voice conversation ---

voice-sim:  ## Whole call without a phone, real STT/LLM/voice, `say` as the candidate (host, a few cents): make voice-sim [SCRIPT=s14_happy_path] [VOICE=Rishi] [ENGINE=realtime]
	$(HOST_RUN) app.scripts.voice_sim $(if $(SCRIPT),--script "$(SCRIPT)") $(if $(VOICE),--voice "$(VOICE)") $(if $(ENGINE),--engine "$(ENGINE)") $(args)

test-stt:  ## Live Deepgram STT tests (about 1.5 minutes, a few cents; needs `make stt-clips`)
	docker compose exec -T backend pytest -q -p no:cacheprovider -m stt app/tests/integration/test_deepgram.py

bench-stt:  ## STT benchmark (about 10 minutes, ~$0.50): make bench-stt [args='--configs n3-in-8k-500 --sets synthetic,real --misses']
	docker compose exec -T backend python -m app.scripts.bench_stt $(args)

# --- Phase 5: telephony ---------------------------------------------------------------------

tunnel:  ## Public HTTPS/WSS URL for Exotel: ngrok's fixed NGROK_DOMAIN from .env (paste into Exotel once), else a Cloudflare quick tunnel (new URL every run). Keeps the Mac awake while running.
	@set -a && . ./.env && set +a && \
	if [ -n "$$NGROK_DOMAIN" ]; then \
	  echo "ngrok -> https://$$NGROK_DOMAIN (fixed; PUBLIC_BACKEND_URL should be this)"; \
	  caffeinate -i ngrok http 8010 --url="https://$$NGROK_DOMAIN" --log=stdout --log-level=warn; \
	else \
	  caffeinate -i cloudflared tunnel --no-autoupdate --url http://localhost:8010; \
	fi

exotel-urls:  ## URLs to paste into the Exotel flow (they contain secrets: don't share them)
	docker compose exec -T backend python -m app.scripts.exotel_urls

test-call:  ## Real call to a verified tester: make test-call phone=+9198XXXXXXXX [mode=screen|full|listen] · telephonic round: make test-call candidate=<id> mode=telephonic [again=1] [override=1]
	@test -n "$(phone)$(candidate)" || (echo 'usage: make test-call phone=+91XXXXXXXXXX [mode=screen|full|listen] | candidate=<id> mode=telephonic'; exit 1)
	docker compose exec -T backend python -m app.scripts.test_call \
	  $(if $(phone),--phone "$(phone)",--candidate-id "$(candidate)") --mode $(or $(mode),screen) $(if $(again),--call-again) $(if $(override),--override-limit)

round-bench:  ## Telephonic round: live-turn model latency and accuracy, no phone call (a few Groq calls): make round-bench [runs=3]
	docker compose exec -T backend python -m app.scripts.round_bench --runs $(or $(runs),3)

final-pass-check:  ## Dry run of the post-call final pass on stored calls (OpenAI, writes nothing)
	docker compose exec -T backend python -m app.scripts.final_pass_check $(args)

dashboard-check:  ## P8-AC1: /dashboard/stats vs plain SQL on the dev database (read-only)
	docker compose exec -T backend python -m app.scripts.dashboard_check

test-frontend:  ## Vitest component tests
	cd frontend && npm test

test-e2e:  ## Playwright: isolated stack (own DB, no provider keys) on ports 8011/3011
	cd frontend && npx playwright test
