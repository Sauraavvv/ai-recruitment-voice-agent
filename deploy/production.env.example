# CallZest production settings. On the server: copy this file to `.env` in the project folder,
# fill it in, and keep it private (it is never committed). See deploy/README.md.

# --- Domains (DNS A records for both, and www.SITE_DOMAIN, point at this server) ---
SITE_DOMAIN=callzest.in
API_DOMAIN=api.callzest.in

# --- Secrets: generate new ones, never reuse the development values ---
# openssl rand -hex 32
APP_SECRET_KEY=
# openssl rand -hex 24   (letters and digits only: it goes into a database URL)
POSTGRES_PASSWORD=

# --- Sign-up ---
# true: anyone can create a new company account at /signup. false: only the accounts you
# create (make prod-user) and the logins their super admins add.
SIGNUP_ENABLED=false

# --- Providers ---
# Copy the AI, speech and telephony keys from your development .env (the same names).
# Then, in the telephony provider's dashboard, point the call app / callback URLs at
# https://API_DOMAIN (the /status page shows whether each provider is configured).

# --- Optional ---
APP_TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO
