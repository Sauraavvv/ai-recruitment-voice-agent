# Copy to .env and fill in. Never commit .env.
# Empty values mean "not set". Provider keys can stay empty until their phase.

# --- Core (required) ---
APP_ENV=development
# At least 32 random characters, e.g. `python3 -c "import secrets; print(secrets.token_urlsafe(48))"`
APP_SECRET_KEY=
# Used when running the backend outside Docker. Docker Compose overrides these with service names.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/recruitment_ai
REDIS_URL=redis://localhost:6380/0

# --- Core (optional) ---
# Host ports Docker publishes (change if something else already uses them).
BACKEND_PORT=8000
FRONTEND_PORT=3000
LOG_LEVEL=INFO
APP_TIMEZONE=Asia/Kolkata
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
# Public HTTPS URL for telephony callbacks (Phase 5). Must be https:// in production.
PUBLIC_BACKEND_URL=

# --- OpenAI (Phase 2) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Optional: reasoning effort for reasoning models (none/minimal/low); per-turn timeout in seconds
OPENAI_REASONING_EFFORT=none
OPENAI_TIMEOUT_S=8

# --- Deepgram (TTS from Phase 3; STT in Phase 4) ---
DEEPGRAM_API_KEY=
# Speech-to-text. Defaults chosen from the Phase 4 benchmark (docs/benchmarks/stt.md).
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_STT_LANGUAGE=en-IN
DEEPGRAM_STT_ENDPOINTING_MS=300
# Off: Deepgram holds back answers that end in a number for seconds when it's on
DEEPGRAM_STT_SMART_FORMAT=false
DEEPGRAM_STT_UTTERANCE_END_MS=1000
DEEPGRAM_STT_KEYTERMS=CTC,LPA,lakhs,notice period

# --- Exotel (Phase 5): docs/telephony.md. SUBDOMAIN = api.exotel.com or api.in.exotel.com ---
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_ACCOUNT_SID=
EXOTEL_SUBDOMAIN=
EXOTEL_CALLER_ID=
# Flow (app) id: Voicebot applet → Hangup. Its URL is printed by `make exotel-urls`.
EXOTEL_APP_ID=
# Phone-side stream format (verified in Phase 5, docs/telephony.md)
TELEPHONY_ENCODING=slin
TELEPHONY_SAMPLE_RATE=8000
TELEPHONY_FRAME_BYTES=3200

# --- Kitten TTS (Phase 3) ---
# Empty = the model bundled in the Docker image (or backend/models/ after `make tts-model`).
KITTEN_MODEL_PATH=
# Empty = Iris (chosen in the Phase 3 listening test)
KITTEN_VOICE=
# ONNX Runtime threads per synthesis; seconds before a synthesis is retried
TTS_THREADS=2
TTS_TIMEOUT_S=3

# --- Which voice speaks ---
# auto = Deepgram Aura when DEEPGRAM_API_KEY is set (Kitten as fallback), else Kitten alone.
# deepgram / kitten force one. TTS_FALLBACK=false runs Deepgram without Kitten.
TTS_PROVIDER=auto
TTS_FALLBACK=true
# Empty = aura-2-harmonia-en (chosen 2026-11-18). Gain matches its loudness to Kitten's Iris.
DEEPGRAM_TTS_VOICE=
DEEPGRAM_TTS_GAIN_DB=6
# No audio from Deepgram within this many seconds → that sentence (and that call) uses Kitten
DEEPGRAM_TTS_FIRST_BYTE_TIMEOUT_S=1.5
# Deepgram's fixed phrases are cached here so restarts don't pay for them again
TTS_CACHE_DIR=artifacts/tts-cache

# --- Google Sheets (Phase 7) ---
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=

# --- Calling ---
MAX_CONCURRENT_CALLS=1
MAX_CALL_ATTEMPTS=3
RETRY_INTERVAL_DAYS=2
