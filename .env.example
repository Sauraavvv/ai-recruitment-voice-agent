# Copy to .env and fill in. Never commit .env.
# Empty values mean "not set". Provider keys can stay empty until their phase.

# --- Core (required) ---
APP_ENV=development
# At least 32 random characters, e.g. `python3 -c "import secrets; print(secrets.token_urlsafe(48))"`
APP_SECRET_KEY=
# Used when running the backend outside Docker. Docker Compose overrides these with service names.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/recruitment_ai
REDIS_URL=redis://localhost:6380/0

# --- Core (optional) ---
# Host ports Docker publishes (change if something else already uses them).
BACKEND_PORT=8000
FRONTEND_PORT=3000
LOG_LEVEL=INFO
APP_TIMEZONE=Asia/Kolkata
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
# Public HTTPS URL for telephony callbacks (Phase 5). Must be https:// in production.
PUBLIC_BACKEND_URL=
# `make tunnel` with an ngrok account: a free fixed domain (PUBLIC_BACKEND_URL=https://<it>), so
# the Exotel flow URL never changes. Empty = a Cloudflare quick tunnel (new URL every run).
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# --- OpenAI (Phase 2) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Optional: reasoning effort for reasoning models (none/minimal/low); per-turn timeout in seconds
OPENAI_REASONING_EFFORT=none
OPENAI_TIMEOUT_S=8

# --- Deepgram (TTS from Phase 3; STT in Phase 4) ---
DEEPGRAM_API_KEY=
# Speech-to-text. Defaults chosen from the Phase 4 benchmark (docs/benchmarks/stt.md).
DEEPGRAM_STT_MODEL=nova-3
DEEPGRAM_STT_LANGUAGE=en-IN
DEEPGRAM_STT_ENDPOINTING_MS=300
# Off: Deepgram holds back answers that end in a number for seconds when it's on
DEEPGRAM_STT_SMART_FORMAT=false
DEEPGRAM_STT_UTTERANCE_END_MS=1000
DEEPGRAM_STT_KEYTERMS=CTC,LPA,lakhs,notice period

# --- Exotel (Phase 5): docs/telephony.md. SUBDOMAIN = api.exotel.com or api.in.exotel.com ---
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_ACCOUNT_SID=
EXOTEL_SUBDOMAIN=
EXOTEL_CALLER_ID=
# Flow (app) id: Voicebot applet → Hangup. Its URL is printed by `make exotel-urls`.
EXOTEL_APP_ID=
# Phone-side stream format (verified in Phase 5, docs/telephony.md)
TELEPHONY_ENCODING=slin
TELEPHONY_SAMPLE_RATE=8000
TELEPHONY_FRAME_BYTES=3200

# --- Kitten TTS (Phase 3) ---
# Empty = the model bundled in the Docker image (or backend/models/ after `make tts-model`).
KITTEN_MODEL_PATH=
# Empty = Iris (chosen in the Phase 3 listening test)
KITTEN_VOICE=
# ONNX Runtime threads per synthesis; seconds before a synthesis is retried
TTS_THREADS=2
TTS_TIMEOUT_S=3

# --- Which voice speaks ---
# auto / kitten = Kitten (Iris, local) first, Deepgram Aura as the fallback when DEEPGRAM_API_KEY
# is set (chosen 2026-11-19 after live calls). deepgram = Deepgram first, Kitten as the fallback.
# TTS_FALLBACK=false runs the first one alone.
TTS_PROVIDER=auto
TTS_FALLBACK=true
# Empty = aura-2-harmonia-en (chosen 2026-11-18). Gain matches its loudness to Kitten's Iris.
DEEPGRAM_TTS_VOICE=
DEEPGRAM_TTS_GAIN_DB=6
# No audio from Deepgram within this many seconds → that sentence (and that call) uses Kitten
DEEPGRAM_TTS_FIRST_BYTE_TIMEOUT_S=1.5
# Deepgram's fixed phrases are cached here so restarts don't pay for them again
TTS_CACHE_DIR=artifacts/tts-cache

# --- Voice conversation (Phase 6, docs/voice-pipeline.md). Times in ms unless named _S ---
# Local VAD: webrtcvad aggressiveness 0-3 plus an energy gate; the gate rises by the echo margin
# while the agent is speaking
VAD_AGGRESSIVENESS=2
VAD_MIN_DBFS=-45
VAD_ECHO_MARGIN_DB=6
VAD_SPEECH_START_MS=100
# Silence after speech → ask Deepgram for the final transcript now (end of turn)
VAD_END_SILENCE_MS=400
# Candidate speech while the agent talks: interrupts after BARGE_IN_MIN_MS if it has real words,
# after BACKCHANNEL_MAX_MS whatever it is ("yes"/"okay" shorter than that never interrupt)
BARGE_IN_MIN_MS=300
BACKCHANNEL_MAX_MS=600
# Wait this long for the candidate's "Hello?" before the greeting
GREETING_WAIT_MS=1200
# No speech this long after the agent finishes → re-prompt, "are you still there?", then close
SILENCE_TIMEOUT_S=7
MAX_UTTERANCE_S=30
# After this the agent reads back what it has and closes; MAX_CALL_DURATION_S is the hard limit
CALL_WRAP_UP_S=600
STT_UNAVAILABLE_S=5
# A cached "Okay." / "Got it." plays while the agent thinks
VOICE_ACKNOWLEDGEMENTS=true
# Synthesize the job's questions while the greeting plays (replies that ask them start at once)
VOICE_TTS_WARM=true
# Reply still silent this long after the candidate finished → "One moment." (0 = never)
VOICE_HOLD_AFTER_MS=3500

# --- Google Sheets (Phase 7) ---
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=

# --- Calling ---
MAX_CONCURRENT_CALLS=1
MAX_CALL_ATTEMPTS=3
RETRY_INTERVAL_DAYS=2
