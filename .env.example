# Copy to .env and fill in. Never commit .env.
# Empty values mean "not set". Provider keys can stay empty until their phase.

# --- Core (required) ---
APP_ENV=development
# At least 32 random characters, e.g. `python3 -c "import secrets; print(secrets.token_urlsafe(48))"`
APP_SECRET_KEY=
# Used when running the backend outside Docker. Docker Compose overrides these with service names.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/recruitment_ai
REDIS_URL=redis://localhost:6380/0

# --- Core (optional) ---
# Host ports Docker publishes (change if something else already uses them).
BACKEND_PORT=8000
FRONTEND_PORT=3000
LOG_LEVEL=INFO
APP_TIMEZONE=Asia/Kolkata
FRONTEND_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
# Public HTTPS URL for telephony callbacks (Phase 5). Must be https:// in production.
PUBLIC_BACKEND_URL=

# --- OpenAI (Phase 2) ---
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Deepgram (Phase 4) ---
DEEPGRAM_API_KEY=

# --- Exotel (Phase 5) — names to be re-checked against Exotel's docs ---
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_ACCOUNT_SID=
EXOTEL_SUBDOMAIN=
EXOTEL_CALLER_ID=

# --- Kitten TTS (Phase 3) ---
KITTEN_MODEL_PATH=
KITTEN_VOICE=

# --- Google Sheets (Phase 7) ---
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=

# --- Calling ---
MAX_CONCURRENT_CALLS=1
MAX_CALL_ATTEMPTS=3
RETRY_INTERVAL_DAYS=2
